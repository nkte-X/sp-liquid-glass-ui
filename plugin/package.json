{
  "name": "liquid-glass-ui",
  "version": "1.1.0",
  "private": true,
  "description": "iOS 26 Liquid Glass behaviour layer for Super Productivity (pairs with themes/ios-liquid-glass.css)",
  "type": "module",
  "scripts": {
    "build": "../themes/build.sh && vite build && node scripts/check-plugin-js.js",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/build-plugin.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@super-productivity/plugin-api": "^20.0.0",
    "@types/node": "^22.10.0",
    "archiver": "^7.0.1",
    "playwright": "^1.65.1",
    "solid-js": "^1.9.11",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-solid": "^2.11.10"
  },
  "license": "MIT"
}
